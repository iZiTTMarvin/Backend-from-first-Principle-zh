---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';

const chapters = (await getCollection('chapters'))
  .filter((c) => !c.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

// Parts are derived, not typed: a chapter's part is a function of its order,
// so inserting a chapter never means re-labelling the ones after it.
const PARTS = [
  { from: 1,  to: 7,  label: '请求之路',  blurb: 'socket 上的字节如何变成一个被处理的请求。' },
  { from: 8,  to: 14, label: '状态与机制',  blurb: '数据存放在哪里，以及围绕它运转的部件。' },
  { from: 15, to: 20, label: '生产环境运行', blurb: '在负载下保持可观测、安全与快速。' },
  { from: 21, to: 24, label: '分布式与扩展', blurb: '交付、测试，并把服务连接起来。' },
];
const grouped = PARTS.map((p) => ({
  ...p,
  chapters: chapters.filter((c) => c.data.order >= p.from && c.data.order <= p.to),
})).filter((p) => p.chapters.length > 0);
---
<Base
  title="后端第一性原理 — 24 章后端工程参考手册"
  description="一份 24 章的后端工程参考，从 HTTP 与路由，到数据库、缓存与 Kafka，再到生产环境部署。包含笔记、图示与可运行的 Go 和 Python 示例。"
  path="/"
>
  <SiteHeader />

  <main class="home" id="main">
    <section class="hero">
      <p class="eyebrow">一份 24 章的工程参考手册</p>
      <h1 class="hero-title">从<em>第一性原理</em>学后端。</h1>
      <p class="hero-lede">
        大多数后端教程教你框架，这里教你框架之下的机器——一个 HTTP 请求到底是什么，
        连接池的大小为什么是这个数，消息代理能保证什么、不能保证什么。每一章都是一本
        自成体系的实战手册，配有图示和可运行的 Go 与 Python 代码。
      </p>
      <div class="hero-actions">
        <a class="btn-primary" href={chapters.length ? `/${chapters[0].id}/` : '#chapters'}>
          从第 01 章开始
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="2.5" y1="8" x2="12.5" y2="8" /><polyline points="8.5,4 12.5,8 8.5,12" /></svg>
        </a>
        <button class="btn-ghost" type="button" data-search-open>搜索全站</button>
      </div>

      <dl class="facts">
        <div class="fact"><dt>章节</dt><dd>{chapters.length}</dd></div>
        <div class="fact"><dt>语言</dt><dd>Go · Python</dd></div>
        <div class="fact"><dt>形式</dt><dd>原理 + 代码</dd></div>
        <div class="fact"><dt>进度</dt><dd data-progress-fact>0 / {chapters.length}</dd></div>
      </dl>
    </section>

    <section class="parts" id="chapters" aria-label="全部章节">
      {grouped.map((part) => (
        <section class="part">
          <header class="part-head">
            <h2 class="part-title">{part.label}</h2>
            <p class="part-blurb">{part.blurb}</p>
            <p class="part-range">
              {String(part.from).padStart(2, '0')}–{String(part.to).padStart(2, '0')}
            </p>
            <p class="part-progress" data-part-progress>0 / {part.chapters.length}</p>
          </header>

          <ul class="grid">
            {part.chapters.map((c) => (
              <li>
                <a class="card" href={`/${c.id}/`} data-chapter-id={c.id}>
                  <span class="card-num">{String(c.data.order).padStart(2, '0')}</span>
                  <span class="card-body">
                    <span class="card-title">{c.data.navTitle ?? c.data.title}</span>
                    <span class="card-summary">{c.data.summary}</span>
                  </span>
                  <span class="card-foot">
                    <span class="card-time">{c.data.readingTime}</span>
                    <span class="card-check">
                      <span aria-hidden="true">✓</span><span class="sr-only">已完成</span>
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </section>

    <section class="contribute">
      <div class="contribute-inner">
        <p class="eyebrow">开源项目</p>
        <h2 class="contribute-title">这些笔记会在争论中变得更好。</h2>
        <p class="contribute-body">
          发现了含糊其辞的解释、遗漏的边界情况，或者画错的图？章节现在都是纯 Markdown——
          一次修正就是一个 pull request，而不是和手写 HTML 搏斗。尤其欢迎其他语言的实现。
        </p>
        <div class="contribute-actions">
          <a class="btn-primary" href="https://github.com/iZiTTMarvin/Backend-from-first-Principle-zh" target="_blank" rel="noopener noreferrer">在 GitHub 上贡献</a>
          <a class="btn-ghost" href="https://github.com/iZiTTMarvin/Backend-from-first-Principle-zh/issues" target="_blank" rel="noopener noreferrer">提交 Issue</a>
        </div>
      </div>
    </section>

    <footer class="site-footer">
      <p>原著 <a href="https://github.com/DsThakurRawat" target="_blank" rel="noopener noreferrer">@DsThakurRawat</a> · 中文版由 <a href="https://github.com/iZiTTMarvin" target="_blank" rel="noopener noreferrer">@iZiTTMarvin</a> 维护</p>
      <p class="quote">「掌握基本原理，框架便不言自明。」</p>
    </footer>
  </main>
</Base>

<style>
  .home {
    max-width: 74rem;
    margin-inline: auto;
    padding-inline: clamp(var(--space-4), 4vw, var(--space-7));
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--accent);
  }

  /* --- hero ------------------------------------------------------------- */
  .hero { padding-block: clamp(var(--space-8), 11vh, var(--space-10)) var(--space-9); }

  .hero-title {
    margin-top: var(--space-5);
    font-size: var(--text-4xl);
    font-weight: 660;
    letter-spacing: -0.038em;
    max-width: 16ch;
  }
  .hero-title em {
    font-family: var(--font-prose);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--accent);
  }

  .hero-lede {
    margin-top: var(--space-5);
    max-width: 60ch;
    font-family: var(--font-prose);
    font-size: var(--text-xl);
    line-height: 1.6;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }

  .btn-primary, .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 42px;
    padding-inline: var(--space-5);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 120ms ease, border-color 120ms ease, transform 120ms ease;
  }
  .btn-primary { background: var(--accent); color: var(--accent-ink); border: 1px solid var(--accent); }
  .btn-primary:hover { transform: translateY(-1px); }
  .btn-primary svg { width: 15px; height: 15px; }
  .btn-ghost { background: var(--surface); color: var(--ink); border: 1px solid var(--line); }
  .btn-ghost:hover { border-color: var(--line-2); }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-7);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .fact dt {
    font-size: var(--text-2xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--ink-3);
  }
  .fact dd {
    margin: var(--space-1) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 500;
  }
  /* CJK glyphs aren't in Geist Mono; fall back to the UI font for them. */
  .fact dd { font-family: var(--font-mono), 'Noto Sans SC Variable', sans-serif; }

  /* --- parts + chapter grid --------------------------------------------- */
  .part + .part { margin-top: var(--space-9); }

  .part-head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: var(--space-3) var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-5);
  }
  .part-title { font-size: var(--text-xl); font-weight: 640; }
  .part-range {
    grid-row: 1;
    grid-column: 2;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
    letter-spacing: var(--tracking-wide);
  }
  .part-blurb {
    grid-column: 1 / -1;
    font-size: var(--text-sm);
    color: var(--ink-3);
  }
  .part-progress {
    grid-row: 3;
    grid-column: 2;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
    letter-spacing: var(--tracking-wide);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .card {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--space-4);
    row-gap: var(--space-2);
    height: 100%;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 140ms ease, background-color 140ms ease, transform 140ms ease;
  }
  .card:hover {
    border-color: var(--accent);
    background: var(--accent-bg);
    transform: translateY(-2px);
  }
  .card.is-done { border-color: var(--accent); }

  .card-check {
    display: none;
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1;
  }
  .card.is-done .card-check { display: block; }

  .card-num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
    padding-top: 0.15em;
  }
  .card-body { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .card-title { font-weight: 620; font-size: var(--text-base); line-height: 1.3; text-wrap: balance; }
  .card-summary {
    font-family: var(--font-prose);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-foot {
    grid-column: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .card-time {
    font-family: var(--font-mono), 'Noto Sans SC Variable', sans-serif;
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    color: var(--ink-3);
  }

  /* --- contribute ------------------------------------------------------- */
  .contribute { margin-top: var(--space-10); }
  .contribute-inner {
    padding: clamp(var(--space-6), 5vw, var(--space-8));
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .contribute-title {
    margin-top: var(--space-4);
    font-size: var(--text-2xl);
    max-width: 22ch;
  }
  .contribute-body {
    margin-top: var(--space-4);
    max-width: 62ch;
    font-family: var(--font-prose);
    font-size: var(--text-lg);
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .contribute-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }

  /* --- footer ----------------------------------------------------------- */
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-9);
    padding-block: var(--space-6) var(--space-8);
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
    color: var(--ink-3);
  }
  .site-footer a { color: var(--ink-2); }
  .quote { font-family: var(--font-prose); font-style: italic; }

  @media (max-width: 560px) {
    .part-head { grid-template-columns: 1fr; }
    .part-range { grid-row: auto; grid-column: 1; }
    .part-progress { grid-row: auto; grid-column: 1; }
  }
</style>

<script>
  const PROGRESS_KEY = 'bfp-progress';
  const readProgress = (): Set<string> => {
    try {
      const raw = JSON.parse(localStorage.getItem(PROGRESS_KEY) ?? '[]');
      return new Set<string>(Array.isArray(raw) ? raw : []);
    } catch { return new Set(); }
  };

  // Re-run on pageshow (bfcache restores the DOM without re-executing this
  // script, so a completion made on another page and then reached via the
  // back button would otherwise render stale) and on storage (another tab
  // changing the same key).
  const render = () => {
    const done = readProgress();

    // Every count is derived from the cards actually rendered, never from
    // the size of the stored list: a renamed or retired chapter leaves a
    // stale id behind, and a stale id must not show up as 25 / 24.
    let doneCount = 0;
    let cardCount = 0;

    document.querySelectorAll<HTMLElement>('.part').forEach((part) => {
      const cards = part.querySelectorAll<HTMLAnchorElement>('[data-chapter-id]');
      let completed = 0;

      cards.forEach((card) => {
        const isDone = done.has(card.dataset.chapterId!);
        card.classList.toggle('is-done', isDone);
        if (isDone) completed += 1;
      });

      const label = part.querySelector<HTMLElement>('[data-part-progress]');
      if (label) label.textContent = `${completed} / ${cards.length}`;

      doneCount += completed;
      cardCount += cards.length;
    });

    const progressFact = document.querySelector<HTMLElement>('[data-progress-fact]');
    if (progressFact) progressFact.textContent = `${doneCount} / ${cardCount}`;
  };

  render();
  addEventListener('pageshow', render);
  addEventListener('storage', (e) => {
    // e.key is null when another tab calls localStorage.clear().
    if (e.key === PROGRESS_KEY || e.key === null) render();
  });
</script>
